# Backend environment variables — copy this file to `.env` and fill in values.
# The real `.env` is gitignored; never commit secrets.

# --- Phase 0 (active) ---
# Runtime environment. API docs are disabled when set to production.
ENVIRONMENT=development

# Allowed CORS origin: the frontend's URL. Local Next.js dev default below.
FRONTEND_ORIGIN=http://localhost:3000

# --- Phase 1 (active) ---
# Supabase JWKS endpoint, used to verify access tokens. Required: the app
# refuses to start without it.
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Auth user UUID allowed to access protected backend routes. Required:
# if unset or empty, every otherwise-valid token is rejected with 403.
OWNER_USER_ID=<uuid>

# --- Phase 2 (active) ---
# Postgres connection string (backend-only; never in the frontend). Required:
# the app refuses to start without it. The `+asyncpg` in the scheme is what
# selects the async driver — a plain `postgresql://` URL will not work.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# --- Phase 8 (active) ---
# Supabase Storage, used for product photos. The backend uploads through the
# Storage REST API, so it needs the project URL and the SECRET key (server-side
# only — this key bypasses RLS and must never appear in the frontend).
# Without these two the app still starts and everything else works; only photo
# upload fails, with a clear 503.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Public-read bucket holding the product photos. Create it once in the Supabase
# dashboard (Storage -> New bucket, "Public bucket" ON) — see README.md.
SUPABASE_PRODUCT_PHOTOS_BUCKET=product-photos
