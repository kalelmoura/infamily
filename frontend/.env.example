# Frontend environment variables — copy this file to `.env.local` and fill in
# values. The real `.env.local` is gitignored; never commit secrets.
# NEXT_PUBLIC_* vars are exposed to the browser by design — only put public
# values here (the Supabase publishable key is safe; the secret key is NOT).

# FastAPI backend base URL. Local dev default below.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public store contact used by the landing page. WhatsApp expects the country
# code, two-digit area code, and phone number, using digits only.
# Example: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000

# Full public URL for the store's Instagram profile.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/inf.amily/

# --- Supabase (used from Phase 1 onwards) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
